[node name="Lore" type="Label" parent="Margin/VBox/ScrollContainer/EntriesContainer/EntryGuardian/M/VB"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.72, 0.75, 1)
theme_override_font_sizes/font_size = 12
text = "Aterrorizante entidade espectral encapuzada armada com a Foice de Luto. Desfere cortes devastadores em arco (Ceifa do Limbo), atrai a atenção dos inimigos e dita as ordens de combate para todas as invocações menores de Necroth."
