; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is also allowed to edit directly.

config_version=5

[application]

config/name="Immortal: O Pacto de Necroth"
run/main_scene="res://ui/screens/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/autoloads/event_bus.gd"
GameManager="*res://core/autoloads/game_manager.gd"
InfamyManager="*res://systems/hierarchy/infamy_manager.gd"
AudioManager="*res://systems/audio/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
